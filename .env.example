#   [REQUIRED]             - app will crash or break without this               
#   [REQUIRED/PRODUCTION]  - can be empty locally, must be set before deploying 
#   [OPTIONAL]             - feature is disabled/degraded if missing           

# [OPTIONAL]
# only needed if you send emails (OTP, etc.)
EMAIL_USER=
# same as above, user app password      
EMAIL_PASS=

# [REQUIRED] - app cannot start without a DB connection
MONGODB_URI=          

# [REQUIRED] - used to sign/verify JWT tokens
JWT_SECRET=

# [REQUIRED] - Next-Auth crashes if this is missing
NEXTAUTH_SECRET=

# [REQUIRED/PRODUCTION]  must be your real domain in prod (e.g. https://yourdomain.com)
NEXTAUTH_URL=http://localhost:3000  

# [OPTIONAL] - only needed if you use the Spotify scraper
SPOTIFY_ID=
SPOTIFY_SECRET=

# [OPTIONAL] - defaults to 3000 if not set
PORT=3000           
DASHBOARD_PORT=3001

# [REQUIRED] - rate limiting, cache, BullMQ all depend on Redis
REDIS_HOST=127.0.0.1
# [REQUIRED] - Redis will not connect without a port
REDIS_PORT=6379
# [REQUIRED/PRODUCTION] - empty is fine locally; must be set in prod     
REDIS_PASSWORD=       

# [REQUIRED/PRODUCTION] /api/prometheus and /api/docs are fully public without this
# Generate with: openssl rand -hex 32
ADMIN_KEY= 

# Socket.IO
# [REQUIRED/PRODUCTION]  set to your real frontend domain in prod; leaving it open allows any site to connect to your WebSocket
ALLOWED_ORIGIN=http://localhost:3000   