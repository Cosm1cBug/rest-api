# legacy-peer-deps=true is required because we run nodemailer ^8.0.11
# (security fix for GHSA-c7w3-x93f-qmm8 + GHSA-vvjj-xcjg-gr5g) but
# next-auth@4.24.14 declares a peerOptional on nodemailer ^7.0.7.
#
# The peer is `peerOptional` and we don't use next-auth's EmailProvider
# (we use CredentialsProvider + GoogleProvider + GitHubProvider), so the
# conflict is purely semver — at runtime nodemailer is never reached
# through next-auth's code path. Forcing v8 lets us close the audit
# advisories without waiting for an upstream next-auth release.
#
# Revisit when next-auth bumps to v5 or relaxes the peer range.
legacy-peer-deps=true
